    "smoke:ui:review-apply": "node scripts/packaged-smoke.mjs review-apply",
    "smoke:ui:applications": "node scripts/packaged-smoke.mjs applications",
    "smoke:ui:shell": "node scripts/packaged-smoke.mjs shell",
    "smoke:ui:profile": "node scripts/packaged-smoke.mjs profile",
    "smoke:ui:onboarding": "node scripts/packaged-smoke.mjs onboarding",
    "smoke:ui:settings": "node scripts/packaged-smoke.mjs settings",
