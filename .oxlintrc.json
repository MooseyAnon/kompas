{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "prefer-const": "error",
    "max-depth": ["warn", { "max": 4 }],
    "max-lines-per-function": [
      "warn",
      { "max": 80, "skipBlankLines": true, "skipComments": true }
    ]
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["src/renderer/**"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
